###############################################################################
# Application
###############################################################################
APP_NAME="Student Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database
#
# Production runs MySQL on Railway, which supplies MYSQL_URL — set DB_URL to it
# rather than filling in the individual fields.
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_portal
DB_USERNAME=root
DB_PASSWORD=
# DB_URL=

###############################################################################
# Session / cache / queue
#
# QUEUE_CONNECTION must not be `sync` in production: notifications and GPA
# recomputation are queued precisely so they stay out of the request cycle.
# A worker has to be running (php artisan queue:work).
###############################################################################
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Frontend / CORS
#
# Comma-separated. Use the pattern list for Vercel preview deployments instead
# of pasting individual deploy URLs into CORS_ALLOWED_ORIGINS.
###############################################################################
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_PATTERNS=

###############################################################################
# Sanctum
#
# Token lifetime in minutes. Null means tokens never expire — do not ship that.
###############################################################################
SANCTUM_TOKEN_EXPIRATION=10080

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.edu"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Cloudinary — profile photo storage
###############################################################################
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_TIMEOUT=15

###############################################################################
# Academic rules (config/academics.php)
#
# The three component maxima must sum to 100 — that is the range the grade
# bands in GradeService are defined over.
###############################################################################
MAX_CREDIT_UNITS_PER_SEMESTER=24
MIN_CREDIT_UNITS_PER_SEMESTER=15
MAX_CA_SCORE=20
MAX_PROJECT_SCORE=20
MAX_EXAM_SCORE=60

###############################################################################
# AWS (unused — retained from the Laravel skeleton)
###############################################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
